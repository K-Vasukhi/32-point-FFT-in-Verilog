`timescale 1ns/1ps
module tb_fft32;

    reg  signed [15:0] in_re  [0:31];
    reg  signed [15:0] in_im  [0:31];
    wire signed [15:0] out_re [0:31];
    wire signed [15:0] out_im [0:31];

    integer i, fout;

    fft32 dut (
        .in_re  (in_re),
        .in_im  (in_im),
        .out_re (out_re),
        .out_im (out_im)
    );

    initial begin
        $readmemh(`IN_RE_FILE, in_re);
        $readmemh(`IN_IM_FILE, in_im);
        #10;
        fout = $fopen(`OUT_FILE, "w");
        for (i = 0; i < 32; i = i + 1)
            $fdisplay(fout, "%0d %0d", out_re[i], out_im[i]);
        $fclose(fout);
        $finish;
    end
endmodule
